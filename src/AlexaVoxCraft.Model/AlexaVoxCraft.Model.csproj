<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>

        <PackageId>AlexaVoxCraft.Model</PackageId>
        <Title>AlexaVoxCraft.Model</Title>
        <Description>Base model definitions for Alexa skill requests, responses, session state, and directives.</Description>
        <PackageTags>alexa;model;request;response;directive;voxcraft;skills</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AlexaVoxCraft.Model.Apl" />
        <InternalsVisibleTo Include="AlexaVoxCraft.Model.InSkillPurchasing" />
        <InternalsVisibleTo Include="AlexaVoxCraft.Smapi" />
        <InternalsVisibleTo Include="AlexaVoxCraft.Model.Tests" />
        <InternalsVisibleTo Include="AlexaVoxCraft.Model.Legacy.Tests" />
        <!-- AplModelContextRootTypeCompletenessTests (AlexaVoxCraft.Model.Apl.Tests) checks ModelContext's
             root-type registration too, since SkillRequest is owned there (Issue #190 follow-up,
             docs/plans/0004-...md Task Group 4). -->
        <InternalsVisibleTo Include="AlexaVoxCraft.Model.Apl.Tests" />
    </ItemGroup>

</Project>
