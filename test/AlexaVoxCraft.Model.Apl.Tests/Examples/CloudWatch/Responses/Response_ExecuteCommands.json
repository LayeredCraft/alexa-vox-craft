                        "headerDivider": false
                      },
                      {
                        "type": "Container",
                        "height": "@spacingMedium",
                        "width": "100%",
                        "display": "none",
                        "id": "AlexaItemList_Separator"
                      },
                      {
                        "type": "Sequence",
                        "scrollDirection": "@textListScrollDirection",
                        "numbered": true,
                        "data": "${listItems}",
                        "items": {
                          "type": "AlexaTextListItem",
                          "touchForward": true,
