                          "primaryAction": "${data.primaryAction}",
                          "primaryText": "${data.primaryText}",
                          "speech": "${data.speech}"
                        },
                        "paddingStart": "@textListPaddingStart",
                        "paddingEnd": 0,
                        "paddingLeft": "@textListPaddingStart",
                        "width": "100%",
                        "grow": 1.0,
                        "id": "${listSequenceId}"
                      },
                      {
                        "hintText": "${hintText}",
                        "type": "AlexaFooter"
                      }
                    ],
                    "height": "100%",
                    "width": "100%",
                    "position": "absolute",
                    "when": "${@viewportProfileCategory != @hubRound}"
                  },
                  {
                    "type": "Sequence",
                    "scrollDirection": "@textListScrollDirection",
                    "numbered": true,
                    "data": "${listItems}",
                    "firstItem": {
                      "type": "AlexaHeader",
                      "headerTitle": "${headerTitle}",
                      "headerSubtitle": "${headerSubtitle}",
                      "headerAttributionImage": "${headerAttributionImage}",
                      "headerDivider": false
                    },
                    "items": {
                      "type": "AlexaTextListItem",
                      "touchForward": true,
                      "tertiaryText": "${data.tertiaryText}",
                      "primaryAction": "${data.primaryAction}",
                      "primaryText": "${data.primaryText}",
                      "speech": "${data.speech}"
                    },
                    "height": "100%",
                    "width": "100%",
                    "grow": 1.0,
                    "position": "absolute",
                    "when": "${viewportProfileCategory == @hubRound}",
                    "id": "${listSequenceId}"
                  }
                ],
                "height": "100vh",
                "width": "100%",
                "speech": "${preambleSpeech}",
                "id": "${speechId}"
