              "description": "Public resource definitions Multiple Choice",
              "numbers": {
                "choiceQuestionTextMaxLines": 3.0
              }
            },
            {
              "dimensions": {
                "choiceColumnWidth": "100%"
              },
              "when": "${@viewportProfileCategory == @hubRound}",
              "numbers": {
                "choiceQuestionTextMaxLines": 0.0
