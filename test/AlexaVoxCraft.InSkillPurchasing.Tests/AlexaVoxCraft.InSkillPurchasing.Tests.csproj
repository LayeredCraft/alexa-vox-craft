<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <LangVersion>default</LangVersion>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\AlexaVoxCraft.InSkillPurchasing\AlexaVoxCraft.InSkillPurchasing.csproj" />
    </ItemGroup>

    <!-- PLAN-0051 (Compono ecosystem migration): replaces the old AlexaVoxCraft.Http.TestKit
         ProjectReference (reflection-based HttpMessageHandler fake + AutoFixture wiring, removed) -
         Compono.Http's TestHttpHandler + Compono.XunitV3's [Compose]/[Shared]. No Compono.NSubstitute
         - nothing composed here needs a substitute; the HTTP client tests compose the SUT via
         IspHttpTestProfile and a shared Compono.Http-backed handler. -->
    <ItemGroup>
      <PackageReference Include="Compono" />
      <PackageReference Include="Compono.XunitV3" />
      <PackageReference Include="Compono.Http" />
      <PackageReference Include="AwesomeAssertions" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Verify.XunitV3" />
    </ItemGroup>

    <ItemGroup>
        <!-- Embed all JSON fixtures under Examples/ -->
        <EmbeddedResource Include="Examples\**\*.json"/>
    </ItemGroup>
    <ItemGroup>
      <Content Update="xunit.runner.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
</Project>
