<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <LangVersion>default</LangVersion>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <!-- Required for Compono.TestDoubles - without it, Compono.Generators never emits a
             double for any interface regardless of the UseGeneratedTestDoubles() runtime call. -->
        <ComponoGeneratedTestDoubles>true</ComponoGeneratedTestDoubles>
        <!-- Referencing AlexaVoxCraft.MediatR.Generators as an analyzer below is not sufficient by
             itself for a source-tree ProjectReference consumer (CLAUDE.md/ADR-0001's documented caveat -
             a packaged NuGet consumer gets all of this for free from AlexaVoxCraft.MediatR.props/.targets,
             which are not imported here). Three things are required together, or the generator silently
             emits nothing and every AddSkillMediator(configuration, ...) call below falls through to the
             hand-written ServiceCollectionExtensions fallback path instead - confirmed the hard way:
             ConfigurationBindingTests originally appeared to validate interceptor binding while actually
             exercising the fallback the whole time, because this property was missing.
             1) EnableMediatRGeneratorInterceptor=true: AlexaVoxCraftDiGenerator.Initialize reads this via
                build_property.EnableMediatRGeneratorInterceptor and requires TryGetValue to succeed - an
                absent property (not just "false") disables interception entirely, since a missing
                property makes the generator's own `TryGetValue(...) && ...` check short-circuit false.
             2) The matching CompilerVisibleProperty entry below, or the generator can't see the property.
             3) InterceptorsNamespaces/InterceptorsPreviewNamespaces including "AlexaVoxCraft.Generated" -
                otherwise the compiler silently ignores the emitted [InterceptsLocation] attributes. -->
        <EnableMediatRGeneratorInterceptor>true</EnableMediatRGeneratorInterceptor>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);AlexaVoxCraft.Generated</InterceptorsNamespaces>
        <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);AlexaVoxCraft.Generated</InterceptorsPreviewNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="EnableMediatRGeneratorInterceptor" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Compono" />
        <PackageReference Include="Compono.XunitV3" />
        <PackageReference Include="Compono.TestDoubles" />
        <PackageReference Include="Compono.Logging" />
        <PackageReference Include="Compono.Options" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\AlexaVoxCraft.MediatR\AlexaVoxCraft.MediatR.csproj" />
        <ProjectReference Include="..\..\src\AlexaVoxCraft.Model\AlexaVoxCraft.Model.csproj" />
        <!-- A source-tree ProjectReference to AlexaVoxCraft.MediatR alone does not pull in its
             interceptor generator as an analyzer (CLAUDE.md). This project reference is required so
             this project's own AddSkillMediator(configuration, ...) call sites are actually intercepted,
             letting ConfigurationBindingTests exercise the real generated interceptor's configuration
             binding (Issue #191, docs/plans/0004-...md Task Group 2) rather than the hand-written
             fallback path. -->
        <ProjectReference Include="..\..\src\AlexaVoxCraft.MediatR.Generators\AlexaVoxCraft.MediatR.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
